{
  "experiment_id": "M1_lumae_ads",
  "parent_id": "M0_baseline",
  "model": {
    "name": "Moment-DETR",
    "feature_extractor": "CLIP-ViT-B/32",
    "temporal_resolution_seconds": 2.0,
    "max_duration_seconds": 150.0
  },
  "training": {
    "dataset_path": "local_data/datasets/lumae_ads_v1/lumae_ads_v1_train.jsonl",
    "batch_size": 4,
    "learning_rate": 0.00001,
    "max_epochs": 50,
    "early_stopping_patience": 10,
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "saliency_loss_weight": 0.0,
    "label_provenance_counts": {
      "human_verified": 18,
      "ai_pseudo_labeled": 16
    },
    "loss_weights": {
      "span_loss": 5.0,
      "giou_loss": 2.0
    }
  },
  "validation": {
    "dataset_path": "local_data/datasets/lumae_ads_v1/lumae_ads_v1_val.jsonl",
    "frequency_epochs": 1,
    "label_provenance": "AI_PSEUDO_LABELED_ONLY",
    "checkpoint_selection_metric": "pseudo_R1_at_0.5_then_mean_IoU"
  },
  "evaluation": {
    "datasets": [
      {
        "name": "Lumae_Ads_test",
        "split_path": "local_data/datasets/lumae_ads_v1/lumae_ads_v1_test.jsonl",
        "metrics": ["R1@0.5", "R1@0.7", "MR_mAP", "mIoU"]
      },
      {
        "name": "QVHighlights_val",
        "split_path": "local_data/canonical/qvhighlights/val.jsonl",
        "metrics": ["R1@0.5", "R1@0.7", "MR_mAP"]
      }
    ]
  },
  "dataset_version": "lumae_ads_v1",
  "training_handoff_path": "local_data/manifests/lumae_ads_v1_training_handoff.json",
  "status": "READY_FOR_GPU_RUN"
}
